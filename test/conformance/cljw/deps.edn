;; Classpath for the cljw load matrix. cljw resolves :git/url + :local/root
;; only, so every vendor dep is pinned by git sha at the revision the matrix
;; was measured against. hive-dsl is pinned to the sha of its released tag
;; v0.5.37 (the release the root deps.edn takes as :mvn/version), so the
;; committed classpath never reaches outside the repo; only hive-spi itself
;; arrives as source.
{:paths []
 :deps {metosin/malli     {:git/url "https://github.com/metosin/malli.git"
                           :git/sha "a74e3b45efa30b3bcdb2e997f337c71614eba3c5"}
        borkdude/dynaload {:git/url "https://github.com/borkdude/dynaload.git"
                           :git/sha "3c1242125307b983db0f6abb289d52a684a7f710"}
        io.github.hive-agi/hive-dsl {:git/url "https://github.com/hive-agi/hive-dsl.git"
                                     :git/sha "80b056398276819bd3833b5588c1fc47c3c7607e"}
        io.github.hive-agi/hive-spi {:local/root "../../.."}}}
