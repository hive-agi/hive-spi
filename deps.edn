{:paths ["src" "resources"]

 ;; The private registry. Declared HERE, not only in a developer's user-level
 ;; deps.edn, so a cold clone and CI resolve hive-agi artifacts identically.
 ;; Credentials come from ~/.m2/settings.xml (server id "hive-gitea").
 :mvn/repos {"hive-gitea" {:url "https://gitea.hive-mcp.com/api/packages/hive-agi/maven"}}
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}

        ;; hive-dsl — defadt (closed sum types) for WorkflowEvent ADT +
        ;; Result spec.
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.10"}

        ;; metosin/malli — schema for the WorkflowAST node map.
        metosin/malli {:mvn/version "0.20.1"}}

 :aliases
 {:dev  {:extra-paths ["dev" "test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}}}

  :test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       com.taoensso/timbre {:mvn/version "6.6.1"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :typed {:extra-paths ["dev-typed"]
          :extra-deps {org.typedclojure/typed.clj.checker {:mvn/version "1.4.0"}}}

  ;; Clojars publishing. version = the repo's VERSION file.
  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.3"}}
   :ns-default hive-build.api}}}
